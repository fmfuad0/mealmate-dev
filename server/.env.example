# ── Runtime ──────────────────────────────────────────
NODE_ENV=development
PORT=5000
TZ=Asia/Dhaka
CURRENCY=BDT

# ── Database ─────────────────────────────────────────
MONGODB_URI= 

# ── Auth / JWT ───────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Google OAuth ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Brevo transactional email API) ──────────────────────────────────
BREVO_API_KEY=
# Must be a sender verified in your Brevo account.
MAIL_FROM="MealMate <hello@mealmate.app>"

# ── CORS / Client ────────────────────────────────────
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://dev-mealmate.netlify.app
