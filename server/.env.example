# ── Runtime ──────────────────────────────────────────
NODE_ENV=development
PORT=5000
TZ=Asia/Dhaka
CURRENCY=BDT

# ── Database ─────────────────────────────────────────
MONGODB_URI= 

# ── Auth / JWT ───────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Google OAuth ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Google SMTP via Nodemailer) ───────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MealMate <yourmail@gmail.com>"

# ── CORS / Client ────────────────────────────────────
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
